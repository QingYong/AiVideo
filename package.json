{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "dev": "sh -c 'PORT=5680 tsx watch src/index.ts & BACKEND_URL=http://localhost:5680 npm run dev:web & wait'",
    "dev:web": "nuxt dev --cwd src/web --port 5679",
    "start": "tsx src/index.ts",
    "build": "npm run build:web && tsc",
    "build:web": "nuxt generate --cwd src/web",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ai-sdk/google": "^3.0.53",
    "@ai-sdk/openai": "^3.0.48",
    "@hono/node-server": "^1.19.11",
    "@mastra/core": "^1.17.0",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.1",
    "fluent-ffmpeg": "^2.1.3",
    "hono": "^4.12.9",
    "lucide-vue-next": "^0.511.0",
    "nuxt": "^3.17.5",
    "pino": "^10.3.1",
    "sharp": "^0.34.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "vue-sonner": "^1.2.4",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
